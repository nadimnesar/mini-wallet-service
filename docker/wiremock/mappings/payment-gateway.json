{
  "mappings": [
    {
      "name": "Visa: missing or wrong API key",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/visa/v1/payments/verify",
        "headers": { "X-Api-Key": { "or": [ { "absent": true }, { "doesNotMatch": "^visa-sandbox-key$" } ] } }
      },
      "response": { "status": 401, "jsonBody": { "error": "INVALID_API_KEY" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "Mastercard: missing or wrong API key",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/mastercard/v1/payments/verify",
        "headers": { "X-Api-Key": { "or": [ { "absent": true }, { "doesNotMatch": "^mastercard-sandbox-key$" } ] } }
      },
      "response": { "status": 401, "jsonBody": { "error": "INVALID_API_KEY" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "gateway_ref containing NOTFOUND: unknown payment",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "contains": "NOTFOUND" } } ]
      },
      "response": { "status": 404, "jsonBody": { "error": "PAYMENT_NOT_FOUND" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "gateway_ref containing ERROR: gateway failure",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "contains": "ERROR" } } ]
      },
      "response": { "status": 500, "jsonBody": { "error": "INTERNAL_ERROR" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "gateway_ref containing TIMEOUT: answers after 10 seconds",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "contains": "TIMEOUT" } } ]
      },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 10000,
        "bodyFileName": "captured.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref containing DECLINED: card declined",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "contains": "DECLINED" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "declined.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref containing PENDING: not captured yet",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "contains": "PENDING" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "pending.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref containing MISMATCH: captured for a different amount",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "contains": "MISMATCH" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "captured-wrong-amount.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "Any other gateway_ref: payment captured",
      "priority": 10,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify"
      },
      "response": {
        "status": 200,
        "bodyFileName": "captured.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    }
  ]
}
