{
  "mappings": [
    {
      "name": "Visa: missing or wrong API key",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/visa/v1/payments/verify",
        "headers": { "X-Api-Key": { "or": [ { "absent": true }, { "doesNotMatch": "^visa-sandbox-key$" } ] } }
      },
      "response": { "status": 401, "jsonBody": { "error": "INVALID_API_KEY" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "Mastercard: missing or wrong API key",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/mastercard/v1/payments/verify",
        "headers": { "X-Api-Key": { "or": [ { "absent": true }, { "doesNotMatch": "^mastercard-sandbox-key$" } ] } }
      },
      "response": { "status": 401, "jsonBody": { "error": "INVALID_API_KEY" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "gateway_ref 00000404-...: unknown payment",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000404-.*" } } ]
      },
      "response": { "status": 404, "jsonBody": { "error": "PAYMENT_NOT_FOUND" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "gateway_ref 00000500-...: gateway failure",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000500-.*" } } ]
      },
      "response": { "status": 500, "jsonBody": { "error": "INTERNAL_ERROR" }, "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "gateway_ref 00000504-...: answers after 10 seconds",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000504-.*" } } ]
      },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 10000,
        "bodyFileName": "captured.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref 00000402-...: card declined",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000402-.*" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "declined.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref 00000202-...: not captured yet",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000202-.*" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "pending.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref 00000422-...: captured for a different amount",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000422-.*" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "captured-wrong-amount.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "gateway_ref 00000423-...: captured for a different wallet",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.gateway_ref", "matches": "^00000423-.*" } } ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "captured-other-wallet.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "Any other gateway_ref: payment captured",
      "priority": 10,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(visa|mastercard)/v1/payments/verify"
      },
      "response": {
        "status": 200,
        "bodyFileName": "captured.json",
        "transformers": [ "response-template" ],
        "headers": { "Content-Type": "application/json" }
      }
    }
  ]
}
